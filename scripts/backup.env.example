# 双云备份配置模板 —— 复制为 scripts/backup.env 后按实际环境填写
# scripts/backup.env 已被 .gitignore 排除，不会入库。

# 主云端路径（rclone remote:path）
CLOUD1=openlist:Google/yuan/nai-backup

# 副云端路径（rclone remote:path）
CLOUD2=openlist:E3BBS/ric/nai-backup

# 本地图片源目录
LOCAL_DIR=/opt/nai-site/data/images

# 本地保留上限（单位：MB）
MAX_LOCAL_MB=2048

# 超限后删除最旧本地图（idle 定时器与每日备份均生效）
ALLOW_LOCAL_PRUNE=1

# 空闲判定阈值（分钟）：最后一张图生成后静默多久才触发备份
IDLE_MINUTES=120
